import sys
import re
from collections import Counter

words = []

for line in sys.stdin:
    for word in re.findall(r"[A-Za-z]+", line.lower()):
        if len(word) > 1:
            words.append(word)

counter = Counter(words)

for word, freq in counter.most_common():
    print(word, freq)
