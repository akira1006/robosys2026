import sys
import re
from collections import Counter

words = []

top_n = None

if len(sys.argv) == 3 and sys.argv[1] == "-n":
    try:
        top_n = int(sys.argv[2])
    except ValueError:
        print("error: N must be integer", file=sys.stderr)
        sys.exit(1)

for line in sys.stdin:
    for word in re.findall(r"[A-Za-z]+", line.lower()):
        if len(word) > 1:
            words.append(word)

counter = Counter(words)

result = counter.most_common(top_n)

for word, freq in result:
    print(word, freq)
